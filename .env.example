# ── Payments (Stripe) ──────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys.
# Use test keys first; swap to live keys to go live.
# Publishable key (pk_…) is used by the browser to render the card fields.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (sk_…) is server-only.
STRIPE_SECRET_KEY=
# Developers → Webhooks → add endpoint https://your-site/api/payments/webhook
# (event: payment_intent.succeeded) → copy its Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=

# ── Order emails (Resend) ──────────────────────────────────────────────
# https://resend.com/api-keys
# The "from" address must be on a domain verified at resend.com/domains —
# sandbox addresses like onboarding@resend.dev can only email the account
# owner's own inbox and will 403 for every real customer/order address.
RESEND_API_KEY=
ORDER_EMAIL_FROM="beBeauty DIY <tellimused@bebeauty.ee>"
# Comma-separate multiple addresses to notify more than one owner inbox.
ORDER_EMAIL_TO=oleheste12@gmail.com,iluinfo1@gmail.com

# ── Meta Conversions API ────────────────────────────────────────────────
# Events Manager → Data sources → pixel 3246042772233645 → Settings →
# Conversions API → Generate access token. Server-only — sends the
# server-side half of the Purchase event (deduped against the browser
# pixel by event_id = Stripe PaymentIntent id). Purchase silently no-ops
# without this, same as the other optional integrations below.
META_CAPI_TOKEN=

# Optional, verification only: Events Manager → Test Events shows a code like
# TEST12345. Set it to route Purchase there instead of live reporting, confirm
# the event arrives with its value/currency/match keys, then REMOVE it — left
# set in production, purchases never reach live reporting.
META_TEST_EVENT_CODE=

# ── GA4 ecommerce tracking ──────────────────────────────────────────────
# view_item / begin_checkout fire client-side (gtag.js); purchase fires
# server-side from the Stripe webhook via Measurement Protocol instead —
# a browser-only Purchase would miss buyers a 3-D Secure/SCA step takes
# off-site. Admin → Data Streams → Web → Measurement Protocol API secrets.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z8Z9HJGYVW
GA4_MEASUREMENT_ID=G-Z8Z9HJGYVW
GA4_API_SECRET=
# Leave unset in production — /debug/mp/collect only validates payloads,
# it never records them. Set to 1 only while checking payload shape.
# GA4_DEBUG=1

# ── Site URL ───────────────────────────────────────────────────────────
# Public base URL, used by the client to build the Stripe return URL.
SITE_URL=https://bebeauty-diy-ee.netlify.app

# ── Orders dashboard (/dashboard) ──────────────────────────────────────
# Single admin login — set your own username/password.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
